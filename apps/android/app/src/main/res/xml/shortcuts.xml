<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share (ShareTargets.kt): each of your devices is a target in the
     share sheet, as a dynamic shortcut in this category. Android 10+. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.mydomain.android.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.mydomain.android.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
