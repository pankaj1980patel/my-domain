<?xml version="1.0" encoding="utf-8"?>
<!-- Where received files are kept (FileActions.downloadDir), for Android 9
     and older, which open them through the FileProvider. -->
<paths>
    <external-files-path name="downloads" path="Download/" />
    <files-path name="downloads_internal" path="downloads/" />
    <!-- Pictures kept in the clipboard history (ClipLog), put back on the
         clipboard as a content Uri by "Copy". -->
    <files-path name="clip_images" path="clip-images/" />
</paths>
