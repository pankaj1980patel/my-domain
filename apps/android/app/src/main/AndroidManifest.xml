<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Automation apps (Tasker, MacroDroid, Automate, ...): an app that asks
         for this, and that you allow when Android asks, may use
         AutomationAppsReceiver (AutomationAppsReceiver.kt). Off in
         Settings until you switch it on. -->
    <permission
        android:name="com.mydomain.android.permission.AUTOMATE"
        android:description="@string/automation_apps_permission_description"
        android:label="@string/automation_apps_permission_label"
        android:protectionLevel="dangerous" />

    <!-- LAN networking + multicast discovery -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Your computers see this screen, after Android's own prompt each time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- A computer's sound playing here (ComputerAudio.kt): a mediaPlayback
         foreground service. Needed from Android 14's targets; harmless before. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Playing this phone's media audio on a computer (PhoneAudio.kt):
         Android's playback capture needs it. Asked in the app, with why;
         nothing is recorded from the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The phone's camera on your computers (CameraShare.kt): asked for in
         the app, with the reason, the first time a computer asks to see it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Find my phone: keep the CPU up while the ring plays (MediaPlayer wake mode),
         and vibrate with the ring notification. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- my-domain over Bluetooth LE (BleLink): advertise and accept computers. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Best-effort IMEI as a stable device id (granted apps only; falls back to ANDROID_ID). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Enumerate installed apps for the notification-sharing picker (API 30+).
         Note: Play Store requires a declared justification for this permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Let your other devices browse and download your photos (Pictures, DCIM/Camera).
         Not asked for at launch: shared only once the user allows photo access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- No maxSdkVersion: targeting Android 9, this is the photo permission
         on every phone (see Sdk.kt). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Switch Wi-Fi (targeting Android 9 allows it; Radios.kt). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android shows Wi-Fi scan results only to apps with this
         (WifiNetworks.kt); asked for when you first list networks, and the
         location itself is never read. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Big files over Wi-Fi Direct or this phone's local-only hotspot
         (WifiDirect.kt, PhoneHotspot.kt): an app targeting Android 13
         needs this instead of location; asked for the first time it's
         needed, with an explanation. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Your computers change brightness, screen timeout and auto-rotate
         (ScreenSettings); the user grants it on a system screen. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lost mode (LostMode.kt): its screen over the lock screen, from the
         background (a full-screen notification), and back after a restart. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Note reminders on time (NoteReminders.kt). Only so you can allow it
         in Android 12+'s "Alarms & reminders" when this app targets it; the
         app never asks on its own, and falls back to inexact alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.App">

        <service
            android:name=".NetService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Brings NetService back after a restart, an update, or the phone
             killing it (ServiceKeeper.kt: a health check by inexact alarm). -->
        <receiver
            android:name=".ServiceKeeperReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The ring notification's Stop action / dismissal (find my phone). -->
        <receiver
            android:name=".DeviceActionReceiver"
            android:exported="false" />

        <!-- Automation apps ask my-domain to do things (AutomationAppsReceiver.kt).
             No intent filters: a request names the class. Both refuse
             everything until switched on in Settings. This one only takes
             broadcasts from apps you've granted the permission... -->
        <receiver
            android:name=".AutomationAppsReceiver"
            android:exported="true"
            android:permission="com.mydomain.android.permission.AUTOMATE" />
        <!-- ...and this one from apps with the key shown in Settings (Tasker
             and the like, which can't ask for another app's permission). -->
        <receiver
            android:name=".AutomationAppsKeyReceiver"
            android:exported="true" />

        <!-- A computer's notification swiped away here (ComputerNotifs.kt). -->
        <receiver
            android:name=".ComputerNotifReceiver"
            android:exported="false" />

        <!-- Note reminders: the alarm, and a reminder's Done / Snooze. -->
        <receiver
            android:name=".NoteReminderReceiver"
            android:exported="false" />

        <!-- Timers: the alarm when one ends, and a timer notification's
             Stop, +1 min, Pause, Resume and Cancel. -->
        <receiver
            android:name=".TimerAlarmReceiver"
            android:exported="false" />

        <!-- The receiving-file notification's Cancel action. -->
        <receiver
            android:name=".FileActionReceiver"
            android:exported="false" />

        <!-- Received files on Android 9 and older (kept in the app's folder):
             shared with the app that opens them. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM: connection signals (dial me back, join the relay, punch). -->
        <!-- Print from the phone on a computer's printer (PrintToComputer.kt):
             "my-domain" in every app's print dialog. -->
        <service
            android:name=".PrintToComputer"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_PRINT_SERVICE">
            <intent-filter>
                <action android:name="android.printservice.PrintService" />
            </intent-filter>
            <meta-data
                android:name="android.printservice"
                android:resource="@xml/print_service" />
        </service>

        <service
            android:name=".MdMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Captures other apps' notifications for the pub/sub sharing feature.
             User must enable it under Settings → Notification access. -->
        <service
            android:name=".NotifListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Cleartext is fine here: this is plain LAN UDP/TCP between trusted peers. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share files from other apps to one of your devices. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Add a device: the camera app or Google Lens opens a scanned join
                 QR code (mydomain://join?…, see core/JoinLinks.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mydomain" android:host="join" />
            </intent-filter>
            <!-- Verify a device: the camera app opens a scanned verify QR code
                 (mydomain://verify?…, see ui/VerifyUi.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mydomain" android:host="verify" />
            </intent-filter>
            <!-- Direct Share: each of your devices in the share sheet (ShareTargets.kt),
                 and the New note launcher shortcut. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- "Read later" in the share sheet, next to the share target above: a
             shared link is saved to the Read later list on all your devices
             (ReadLaterShareActivity.kt). -->
        <activity
            android:name=".ReadLaterShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/read_later_share_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- "Download on…" in the share sheet: a shared link is downloaded by
             another of your devices itself (DownloadShareActivity.kt). -->
        <activity
            android:name=".DownloadShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/dl_share_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- A share to one device's share-sheet target, sent without the picker. -->
        <activity
            android:name=".DirectShareActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Your computers see this screen: Android's prompt, then the sharing. -->
        <activity
            android:name=".ScreenConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Why Wi-Fi Direct and the hotspot need the permission
             (WifiDirect.kt): asked once, the first time it's needed. -->
        <activity
            android:name=".WifiDirectPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- This phone's camera on a computer (CameraShare.kt): asks every
             time, then streams in the foreground with Stop. -->
        <activity
            android:name=".CameraConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".CameraShareService"
            android:exported="false"
            android:foregroundServiceType="camera" />
        <!-- This phone's audio on a computer (PhoneAudio.kt): the
             microphone permission, then Android's own prompt, every time. -->
        <activity
            android:name=".PhoneAudioConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".PhoneAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- A computer's sound on this phone (ComputerAudio.kt): asks before
             it plays (Play / Not now), then plays in the foreground with Stop. -->
        <activity
            android:name=".ComputerAudioAskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".ComputerAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The touchpad full screen (the touchpad tile's Enlarge). -->
        <!-- Insert from phone: a photo or a document scan a computer asked
             for (InsertCapture.kt), and its notification's Cancel. -->
        <activity
            android:name=".InsertCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.App" />
        <receiver
            android:name=".InsertCancelReceiver"
            android:exported="false" />
        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:theme="@style/Theme.App" />
            <!-- Taps radio switches and presses keys for your computers (PhoneHelper.kt). -->
        <service
            android:name=".PhoneHelper"
            android:exported="true"
            android:label="@string/helper_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_helper" />
        </service>
        <!-- Quick Settings tiles (QuickTiles.kt): send clipboard to / lock the computer. -->
        <service
            android:name=".ClipTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_send"
            android:label="@string/qs_clip_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".LockTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_lock_lock"
            android:label="@string/qs_lock_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Quick Settings tile (QuickTiles.kt): open the app on a new note. -->
        <service
            android:name=".NewNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_note_add"
            android:label="@string/qs_new_note_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Home-screen widget (HomeWidget.kt): the computer, with the same actions. -->
        <receiver
            android:name=".HomeWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_info" />
        </receiver>
        <receiver
            android:name=".HomeWidgetActionReceiver"
            android:exported="false" />
        <!-- Notes home-screen widget (NotesWidget.kt): pinned and recent notes, and "+". -->
        <receiver
            android:name=".NotesWidget"
            android:exported="true"
            android:label="@string/notes_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>
        <activity
            android:name=".ClipSendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Lost mode: your message over the lock screen (never unlocks it).
             Direct-boot aware, so it's back after a restart before the first unlock. -->
        <activity
            android:name=".LostModeActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.App" />
        <receiver
            android:name=".LostModeBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Shizuku hands this app its binder here (ADR-0006, Privileged.kt). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
