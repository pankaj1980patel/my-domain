<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app bundle's Info.plist by Tauri. -->
<plist version="1.0">
<dict>
	<!-- md-ble: reach your phone over Bluetooth LE when there's no network;
	     calls.rs: this Mac as your phone's hands-free for calls. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>my-domain uses Bluetooth to reach your phone when there is no network between them, and to take your phone's calls on this Mac when you turn that on.</string>
	<!-- calls.rs: your voice to the phone during a call taken on this Mac. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>my-domain sends your voice to your phone during a call you take on this Mac.</string>
	<!-- Now playing: asks Spotify or Music what they're playing (AppleScript). -->
	<key>NSAppleEventsUsageDescription</key>
	<string>my-domain shows your other devices what Spotify or Music is playing.</string>
	<!-- Find my computer: your phone asks where this computer is (location.rs). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>my-domain tells your own phone where this computer is, when you allow it in Settings.</string>
	<key>NSLocationUsageDescription</key>
	<string>my-domain tells your own phone where this computer is, when you allow it in Settings.</string>
	<!-- send_to.rs: "Send with my-domain" in Finder's Services menu (right-click
	     a file or folder: Services, or Quick Actions). AppKit calls
	     sendWithMyDomain:userData:error: on the provider the app registers.
	     macOS lists it once the app is in /Applications and has been opened;
	     if it doesn't show, log out and in, or run
	     /System/Library/CoreServices/pbs -update -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Send with my-domain</string>
			</dict>
			<key>NSMessage</key>
			<string>sendWithMyDomain</string>
			<key>NSPortName</key>
			<string>my-domain</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
